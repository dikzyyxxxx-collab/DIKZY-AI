"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import ComicLogo from "../../components/ComicLogo";
import { AUTH } from "../../lib/config";

export default function LoginPage() {
  const router = useRouter();
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [shake, setShake] = useState(false);

  function handleSubmit(e) {
    e.preventDefault();

    if (username === AUTH.username && password === AUTH.password) {
      sessionStorage.setItem("dikzy_logged_in", "true");
      router.push("/chat");
    } else {
      setError("Username atau password salah! Coba lagi, pahlawan.");
      setShake(true);
      setTimeout(() => setShake(false), 400);
    }
  }

  return (
    <main
      style={{
        minHeight: "100vh",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        padding: "20px",
        gap: "20px",
      }}
    >
      <div style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: "8px" }}>
        <ComicLogo size={80} />
        <h1 style={{ fontSize: "3rem", color: "var(--black)" }}>DIKZY AI</h1>
        <p style={{ fontFamily: "var(--font-body)", fontWeight: 700, color: "var(--gray-700)" }}>
          Asisten AI • 3 Tipe Pemikiran
        </p>
      </div>

      <form
        onSubmit={handleSubmit}
        className="comic-panel"
        style={{
          width: "100%",
          maxWidth: "360px",
          padding: "28px",
          display: "flex",
          flexDirection: "column",
          gap: "16px",
          transform: shake ? "translateX(0px)" : "none",
          animation: shake ? "shake 0.4s" : "none",
        }}
      >
        <h2 style={{ fontSize: "1.6rem", textAlign: "center" }}>MASUK DULU!</h2>

        <div style={{ display: "flex", flexDirection: "column", gap: "6px" }}>
          <label style={{ fontWeight: 700, fontSize: "0.9rem" }}>Username</label>
          <input
            className="comic-input"
            type="text"
            value={username}
            onChange={(e) => setUsername(e.target.value)}
            placeholder="Masukkan username"
            required
          />
        </div>

        <div style={{ display: "flex", flexDirection: "column", gap: "6px" }}>
          <label style={{ fontWeight: 700, fontSize: "0.9rem" }}>Password</label>
          <input
            className="comic-input"
            type="password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            placeholder="Masukkan password"
            required
          />
        </div>

        {error && (
          <p style={{ color: "#b00020", fontWeight: 700, fontSize: "0.85rem", textAlign: "center" }}>
            {error}
          </p>
        )}

        <button type="submit" className="comic-btn" style={{ width: "100%" }}>
          LOGIN!
        </button>
      </form>

      <style>{`
        @keyframes shake {
          0%, 100% { transform: translateX(0); }
          25% { transform: translateX(-8px); }
          75% { transform: translateX(8px); }
        }
      `}</style>
    </main>
  );
}
